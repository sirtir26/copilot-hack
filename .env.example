PORT=3000
WEBEX_BOT_TOKEN=your_webex_bot_token
WEBEX_BOT_EMAIL=your-bot-email@webex.bot
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token

# Comma separated roomId:ISSUE-123 mappings
ROOM_JIRA_MAPPINGS=room-id-1:PROJ-101,room-id-2:PROJ-102

# Runs every day at 18:00 server time (minute hour day month weekday)
DAILY_CRON=0 18 * * *
